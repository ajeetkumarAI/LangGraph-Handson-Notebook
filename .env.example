# Copy this file to .env (same folder) and fill in your key.
# .env is in .gitignore - it is never committed.
OPENAI_API_KEY=sk-your-key-here

# Optional: model used in all notebooks (default: gpt-4.1-nano - small and cheap)
# Use gpt-4.1-mini if an agent/multi-agent lesson needs a smarter model.
OPENAI_MODEL=gpt-4.1-nano

# Optional (Day 15): LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langgraph-course
